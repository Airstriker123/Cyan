BEGIN
    IMPORT modules (colors_app, json, requests, time, sys)

    FUNCTION Slow
        FOR EACH line IN text SPLIT BY NEW LINE
            PRINT line WITH FLUSH
            WAIT delay SECONDS
        END FOR
    END FUNCTION

    FUNCTION MainColor2
        SET start_color = (0, 200, 150)
        SET end_color = (0, 255, 255)
        SET num_steps = 16
        COMPUTE colors LIST FOR GRADIENT

        FOR i FROM 0 TO num_steps - 1
            CALCULATE INTERPOLATED COLORS
            APPEND TO colors LIST
        END FOR

        REVERSE colors LIST (excluding last element)

        FUNCTION text_color(r, g, b)
            RETURN FORMATTED STRING WITH RGB COLOR CODES
        END FUNCTION

        CREATE LIST result
        SPLIT text INTO lines

        FOR EACH line IN lines
            COMPUTE color_index
            APPLY COLOR TO line
            ADD TO result LIST
        END FOR

        RETURN JOINED result LIST AS STRING
    END FUNCTION

    DISPLAY ASCII ART USING MainColor2 FUNCTION

    DECLARE SET api_keys CONTAINING MULTIPLE API KEYS
    SET api_url TO "https://api.aimlapi.com/v1/chat/completions"

    FUNCTION type_text(text, delay)
        FOR EACH char IN text
            PRINT char WITHOUT NEWLINE
            WAIT delay SECONDS
        END FOR
        PRINT NEW LINE
    END FUNCTION

    FUNCTION send_message(user_message)
        IF user_message IS EMPTY
            PRINT "Error: No message entered."
            RETURN
        END IF

        SET payload AS JSON OBJECT WITH MODEL AND USER MESSAGE

        FOR EACH api_key IN api_keys
            TRY
                SEND HTTP POST REQUEST TO api_url WITH api_key AND payload
                STORE RESPONSE IN data

                IF data CONTAINS "choices"
                    SET ai_message TO RETURNED AI RESPONSE
                    PRINT "Cyan🤖: " WITHOUT NEWLINE
                    CALL type_text(ai_message, 0.005)
                    BREAK LOOP
                ELSE
                    PRINT "Error: Unable to retrieve response. Trying next API key."
                    PRINT "Switching to the next API key, please wait..."
                END IF
            CATCH REQUEST EXCEPTION
                PRINT "Error: Unable to connect with API key."
                PRINT "Attempting to use the next available API key..."
        END FOR
    END FUNCTION

    FUNCTION Cyan_AI()
        CALL Slow TO DISPLAY ASCII ART
        PRINT "Remember to type 'exit' once you have completed your prompts!"
        PRINT "Cyan🤖: " WITHOUT NEWLINE
        CALL type_text("Hello, how can I help you today? 😁", 0.005)

        WHILE TRUE
            PROMPT USER FOR INPUT (user_input)
            IF user_input IS "exit"
                PRINT "Exiting program."
                BREAK LOOP
            END IF
            CALL send_message(user_input)
        END WHILE
    END FUNCTION

    CALL Cyan_AI()

END
